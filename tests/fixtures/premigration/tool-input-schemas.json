    "upsert_geckolib_animation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Animation name (the clip key), e.g. animation.<entity>.<action>."
        },
        "loop": {
          "type": "string",
          "enum": [
            "once",
            "loop",
            "hold_on_last_frame"
          ],
          "description": "GeckoLib loop mode (default once)."
        },
        "length": {
          "type": "number",
          "minimum": 0,
          "description": "Clip length in seconds."
        },
        "override": {
          "type": "boolean",
          "description": "Override lower-priority animations (default false)."
        },
        "anim_time_update": {
          "type": "string",
          "description": "Molang expression driving clip time (passed through, never evaluated)."
        },
        "bones": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "rotation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "time": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Keyframe time in seconds from clip start."
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string"
                                }
                              ],
                              "description": "A number or a molang expression string (molang is passed through, never evaluated)."
                            },
                            {
                              "$ref": "#/properties/bones/additionalProperties/properties/rotation/items/properties/value/anyOf/2/items/0"
                            },
                            {
                              "$ref": "#/properties/bones/additionalProperties/properties/rotation/items/properties/value/anyOf/2/items/0"
                            }
                          ]
                        }
                      ],
                      "description": "Keyframe value in the GeckoLib .animation.json convention: a number or molang string (applied to all three axes) or an [x, y, z] array of number|molang-string."
                    },
                    "interpolation": {
                      "type": "string",
                      "enum": [
                        "linear",
                        "catmullrom",
                        "step"
                      ],
                      "description": "Interpolation to the next keyframe (default linear)."
                    },
                    "easing": {
                      "type": "string",
                      "enum": [
                        "linear",
                        "step",
                        "easeInQuad",
                        "easeOutQuad",
                        "easeInOutQuad",
                        "easeInCubic",
                        "easeOutCubic",
                        "easeInOutCubic",
                        "easeInQuart",
                        "easeOutQuart",
                        "easeInOutQuart",
                        "easeInQuint",
                        "easeOutQuint",
                        "easeInOutQuint",
                        "easeInSine",
                        "easeOutSine",
                        "easeInOutSine",
                        "easeInExpo",
                        "easeOutExpo",
                        "easeInOutExpo",
                        "easeInCirc",
                        "easeOutCirc",
                        "easeInOutCirc",
                        "easeInBack",
                        "easeOutBack",
                        "easeInOutBack",
                        "easeInElastic",
                        "easeOutElastic",
                        "easeInOutElastic",
                        "easeInBounce",
                        "easeOutBounce",
                        "easeInOutBounce"
                      ],
                      "description": "GeckoLib per-keyframe easing name (absent means linear)."
                    },
                    "easingArgs": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "description": "Numeric easing arguments; used by the Back/Elastic/Bounce families and step."
                    }
                  },
                  "required": [
                    "time",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "position": {
                "$ref": "#/properties/bones/additionalProperties/properties/rotation"
              },
              "scale": {
                "$ref": "#/properties/bones/additionalProperties/properties/rotation"
              }
            },
            "additionalProperties": false
          },
          "description": "Bone name → rotation/position/scale keyframe lists. Bone names must match current group names. Values use the GeckoLib .animation.json convention (what export_geckolib_animations writes): rotation X/Y and position X are stored inverted relative to the Blockbench UI; the handler applies that mapping."
        },
        "replace": {
          "type": "boolean",
          "description": "Must be true to overwrite an existing animation with the same name; applies to this call only."
        }
      },
      "required": [
        "name",
        "length",
        "bones"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "delete_geckolib_animation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "get_geckolib_animation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "capture_geckolib_animation_frame": {
      "type": "object",
      "properties": {
        "animation": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the GeckoLib animation clip to pose and capture."
        },
        "time": {
          "type": "number",
          "minimum": 0,
          "description": "Timestamp in seconds to render within the named clip."
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1920
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1920
        },
        "angle_preset": {
          "type": "string",
          "enum": [
            "initial",
            "top",
            "bottom",
            "south",
            "north",
            "east",
            "west",
            "isometric_right",
            "isometric_left",
            "true_isometric_right",
            "true_isometric_left"
          ],
          "description": "Render the posed GeckoLib model from a native Blockbench camera preset through the offscreen preview; omit to capture the currently visible view."
        }
      },
      "required": [
        "animation",
        "time"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
}

    },
    "set_cube_uv": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string"
        },
        "box_uv": {
          "type": "boolean",
          "description": "Switch the cube UV mode. A mode differing from the format default needs a format with optional per-cube box UV; otherwise the call fails with E_FORMAT_UNSUPPORTED."
        },
        "uv_offset": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "number"
            },
            {
              "$ref": "#/properties/uv_offset/items/0"
            }
          ],
          "description": "Box-UV texture offset; valid in box UV mode only."
        },
        "mirror_uv": {
          "type": "boolean",
          "description": "Box-UV X mirroring; valid in box UV mode only."
        },
        "faces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "uv": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": [
                  {
                    "$ref": "#/properties/uv_offset/items/0"
                  },
                  {
                    "$ref": "#/properties/uv_offset/items/0"
                  },
                  {
                    "$ref": "#/properties/uv_offset/items/0"
                  },
                  {
                    "$ref": "#/properties/uv_offset/items/0"
                  }
                ]
              },
              "rotation": {
                "type": "number",
                "enum": [
                  0,
                  90,
                  180,
                  270
                ],
                "description": "Face texture rotation in degrees (quarter turns)."
              }
            },
            "required": [
              "uv"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "enum": [
              "north",
              "south",
              "east",
              "west",
              "up",
              "down"
            ]
          },
          "description": "Per-face UV rectangles plus optional rotation; valid in per-face UV mode only."
        }
      },
      "required": [
        "uuid"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "set_texture_resolution": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",

{
  "name": "tool-arguments-omitted",
  "proves": "Omitting the tools/call arguments member entirely is rejected by the dependency validation layer for both a no-parameter tool and a tool with required parameters, and surfaces as an isError text result rather than a JSON-RPC error.",
  "covers": [
    "omitted-arguments"
  ],
  "process": {
    "args": [
      "--direct"
    ],
    "environment": "isolated-empty-config-home"
  },
  "steps": [
    {
      "label": "initialize with protocolVersion 2025-11-25",
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "premigration-wire-recorder",
            "version": "1.0.0"
          }
        }
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "result": {
              "protocolVersion": "2025-11-25",
              "capabilities": {
                "tools": {
                  "listChanged": true
                }
              },
              "serverInfo": {
                "name": "minecraft-blockbench-mcp",
                "version": "0.1.0"
              }
            },
            "jsonrpc": "2.0",
            "id": 1
          },
          "rawSha256": "cfd279481b15c2356cba73a613a7a2973c2b409f079fb43d40cf59df5a5c3064"
        }
      ]
    },
    {
      "label": "notifications/initialized carries no response",
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "awaitStdoutMessages": 0,
      "expect": []
    },
    {
      "label": "tools/call health with no arguments member",
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/call",
        "params": {
          "name": "health"
        }
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "MCP error -32602: Input validation error: Invalid arguments for tool health: [\n  {\n    \"code\": \"invalid_type\",\n    \"expected\": \"object\",\n    \"received\": \"undefined\",\n    \"path\": [],\n    \"message\": \"Required\"\n  }\n]"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 2
          },
          "rawSha256": "48921b4d4cf82818cc2e02eb2c710e339462be24ecc97eb6c6f9dc195bbaedea"
        }
      ]
    },
    {
      "label": "tools/call read_file with no arguments member",
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "read_file"
        }
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "MCP error -32602: Input validation error: Invalid arguments for tool read_file: [\n  {\n    \"code\": \"invalid_type\",\n    \"expected\": \"object\",\n    \"received\": \"undefined\",\n    \"path\": [],\n    \"message\": \"Required\"\n  }\n]"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 3
          },
          "rawSha256": "24a80dad1243823fde67170c7915315b07b041ee4b771ec9909a352e2b80055b"
        }
      ]
    }
  ],
  "termination": {
    "kind": "stdin-eof",
    "exitCode": 0,
    "signal": null,
    "trailingStdoutMessages": []
  },
  "stdout": {
    "lineCount": 3,
    "everyLineIsOneJsonRpcObject": true,
    "normalizationRewroteStdout": false
  },
  "stderrLines": [
    "[minecraft-blockbench-mcp] Config source: no config file (CLI/env/defaults only).",
    "[minecraft-blockbench-mcp] Setup issue (E_SECRET_MISSING): No shared secret is configured; the plugin listener was not started. Set --secret, BLOCKBENCH_MCP_SECRET, or the config file secret.",
    "[minecraft-blockbench-mcp] MCP server connected over stdio.",
    "[minecraft-blockbench-mcp] Shutting down (stdio closed)."
  ]
}

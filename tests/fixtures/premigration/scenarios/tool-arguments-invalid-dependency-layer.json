{
  "name": "tool-arguments-invalid-dependency-layer",
  "proves": "Arguments that fail the advertised input schema are rejected before the handler runs: a wrong value type and an unrecognized extra key both return the dependency validation text with isError true.",
  "covers": [
    "invalid-arguments"
  ],
  "process": {
    "args": [
      "--direct"
    ],
    "environment": "isolated-empty-config-home"
  },
  "steps": [
    {
      "label": "initialize with protocolVersion 2025-11-25",
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "premigration-wire-recorder",
            "version": "1.0.0"
          }
        }
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "result": {
              "protocolVersion": "2025-11-25",
              "capabilities": {
                "tools": {
                  "listChanged": true
                }
              },
              "serverInfo": {
                "name": "minecraft-blockbench-mcp",
                "version": "0.1.0"
              }
            },
            "jsonrpc": "2.0",
            "id": 1
          },
          "rawSha256": "cfd279481b15c2356cba73a613a7a2973c2b409f079fb43d40cf59df5a5c3064"
        }
      ]
    },
    {
      "label": "notifications/initialized carries no response",
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "awaitStdoutMessages": 0,
      "expect": []
    },
    {
      "label": "wrong value type for read_file.path",
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/call",
        "params": {
          "name": "read_file",
          "arguments": {
            "path": 123
          }
        }
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "MCP error -32602: Input validation error: Invalid arguments for tool read_file: [\n  {\n    \"code\": \"invalid_type\",\n    \"expected\": \"string\",\n    \"received\": \"number\",\n    \"path\": [\n      \"path\"\n    ],\n    \"message\": \"Expected string, received number\"\n  }\n]"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 2
          },
          "rawSha256": "41b5492dddd9950036befe7efbb37f66dbe4f36101c179187c20f20a5d163131"
        }
      ]
    },
    {
      "label": "unrecognized extra key for read_file",
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "read_file",
          "arguments": {
            "path": "model.json",
            "bogus": 1
          }
        }
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "MCP error -32602: Input validation error: Invalid arguments for tool read_file: [\n  {\n    \"code\": \"unrecognized_keys\",\n    \"keys\": [\n      \"bogus\"\n    ],\n    \"path\": [],\n    \"message\": \"Unrecognized key(s) in object: 'bogus'\"\n  }\n]"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 3
          },
          "rawSha256": "ee2ee3aafc2fcef8f94f4b0221e814655f56643189881987434d0fe88c5078fb"
        }
      ]
    }
  ],
  "termination": {
    "kind": "stdin-eof",
    "exitCode": 0,
    "signal": null,
    "trailingStdoutMessages": []
  },
  "stdout": {
    "lineCount": 3,
    "everyLineIsOneJsonRpcObject": true,
    "normalizationRewroteStdout": false
  },
  "stderrLines": [
    "[minecraft-blockbench-mcp] Config source: no config file (CLI/env/defaults only).",
    "[minecraft-blockbench-mcp] Setup issue (E_SECRET_MISSING): No shared secret is configured; the plugin listener was not started. Set --secret, BLOCKBENCH_MCP_SECRET, or the config file secret.",
    "[minecraft-blockbench-mcp] MCP server connected over stdio.",
    "[minecraft-blockbench-mcp] Shutting down (stdio closed)."
  ]
}

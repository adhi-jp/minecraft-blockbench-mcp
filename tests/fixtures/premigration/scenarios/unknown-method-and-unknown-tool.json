{
  "name": "unknown-method-and-unknown-tool",
  "proves": "An unknown JSON-RPC method returns error -32601 while an unknown tool name returns a successful response carrying an isError text result. The two failure shapes are different and both are frozen.",
  "covers": [
    "unknown-method",
    "unknown-tool"
  ],
  "process": {
    "args": [
      "--direct"
    ],
    "environment": "isolated-empty-config-home"
  },
  "steps": [
    {
      "label": "initialize with protocolVersion 2025-11-25",
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-11-25",
          "capabilities": {},
          "clientInfo": {
            "name": "premigration-wire-recorder",
            "version": "1.0.0"
          }
        }
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "result": {
              "protocolVersion": "2025-11-25",
              "capabilities": {
                "tools": {
                  "listChanged": true
                }
              },
              "serverInfo": {
                "name": "minecraft-blockbench-mcp",
                "version": "0.1.0"
              }
            },
            "jsonrpc": "2.0",
            "id": 1
          },
          "rawSha256": "cfd279481b15c2356cba73a613a7a2973c2b409f079fb43d40cf59df5a5c3064"
        }
      ]
    },
    {
      "label": "notifications/initialized carries no response",
      "send": {
        "jsonrpc": "2.0",
        "method": "notifications/initialized"
      },
      "awaitStdoutMessages": 0,
      "expect": []
    },
    {
      "label": "unknown JSON-RPC method",
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "blockbench/not-a-method",
        "params": {}
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32601,
              "message": "Method not found"
            }
          },
          "rawSha256": "7596481db9f971867edfeae5417449e906fd1bbd75ce5e2eec5bb925170053bf"
        }
      ]
    },
    {
      "label": "unknown tool name",
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "not_a_registered_tool",
          "arguments": {}
        }
      },
      "awaitStdoutMessages": 1,
      "expect": [
        {
          "message": {
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "MCP error -32602: Tool not_a_registered_tool not found"
                }
              ],
              "isError": true
            },
            "jsonrpc": "2.0",
            "id": 3
          },
          "rawSha256": "df15df1af2f029870f93b85dedbf16ffb81ddb2c4ce6e4570d88b1164655eeb9"
        }
      ]
    }
  ],
  "termination": {
    "kind": "stdin-eof",
    "exitCode": 0,
    "signal": null,
    "trailingStdoutMessages": []
  },
  "stdout": {
    "lineCount": 3,
    "everyLineIsOneJsonRpcObject": true,
    "normalizationRewroteStdout": false
  },
  "stderrLines": [
    "[minecraft-blockbench-mcp] Config source: no config file (CLI/env/defaults only).",
    "[minecraft-blockbench-mcp] Setup issue (E_SECRET_MISSING): No shared secret is configured; the plugin listener was not started. Set --secret, BLOCKBENCH_MCP_SECRET, or the config file secret.",
    "[minecraft-blockbench-mcp] MCP server connected over stdio.",
    "[minecraft-blockbench-mcp] Shutting down (stdio closed)."
  ]
}
